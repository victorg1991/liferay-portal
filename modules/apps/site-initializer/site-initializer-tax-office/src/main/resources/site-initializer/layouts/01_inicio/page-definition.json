								}
							}
						},
						{
							"id": "actions",
							"value": {
								"text": {
									"value_i18n": {
										"en_US": "<ul><li><a href=\"#\">File the income tax return</a><a class=\"tax-highlighted-actions-help\" href=\"#\">Help</a></li><li><a href=\"#\">Check my pending notifications</a><a class=\"tax-highlighted-actions-help\" href=\"#\">Help</a></li><li><a href=\"#\">Request a tax certificate</a><a class=\"tax-highlighted-actions-help\" href=\"#\">Help</a></li><li><a href=\"#\">Pay and defer debts</a><a class=\"tax-highlighted-actions-help\" href=\"#\">Help</a></li><li><a href=\"#\">Book an appointment</a><a class=\"tax-highlighted-actions-help\" href=\"#\">Help</a></li></ul>",
										"es_ES": "<ul><li><a href=\"#\">Presentar la declaración de la Renta</a><a class=\"tax-highlighted-actions-help\" href=\"#\">Ayuda</a></li><li><a href=\"#\">Consultar mis notificaciones pendientes</a><a class=\"tax-highlighted-actions-help\" href=\"#\">Ayuda</a></li><li><a href=\"#\">Solicitar un certificado tributario</a><a class=\"tax-highlighted-actions-help\" href=\"#\">Ayuda</a></li><li><a href=\"#\">Pagar y aplazar deudas</a><a class=\"tax-highlighted-actions-help\" href=\"#\">Ayuda</a></li><li><a href=\"#\">Solicitar cita previa</a><a class=\"tax-highlighted-actions-help\" href=\"#\">Ayuda</a></li></ul>"
